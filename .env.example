# ── Railway FastAPI (backend/) ──────────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-service-role-key
ANTHROPIC_API_KEY=sk-ant-api03-...
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:3000   # Set to Vercel URL in production

# ── Vercel Next.js (frontend/) ──────────────────────────────────────────────
# Server-side (Next.js API routes / proxy)
BACKEND_URL=http://localhost:8000    # Set to Railway URL in production
# Client-side (exposed to browser — only non-secret values)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# ── Local transcription server (transcription/) ─────────────────────────────
HF_TOKEN=hf_your_huggingface_token  # Required for pyannote diarization model
